option('xwayland', type: 'feature', value: 'auto', description: 'Enable XWayland support')
option('asan', type: 'boolean', value: false, description: 'Enable AddressSanitizer')
option('tests', type: 'feature', value: 'auto', description: 'Build the cmocka unit tests (auto: enable if cmocka is installed, skip with a notice otherwise)')
